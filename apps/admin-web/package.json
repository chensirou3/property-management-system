{
  "name": "admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run && npm run pages:acceptance:check",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual-baselines.spec.ts",
    "pages:acceptance": "node scripts/generate-page-acceptance-cards.mjs",
    "pages:acceptance:check": "node scripts/generate-page-acceptance-cards.mjs --check",
    "api:generate": "openapi-typescript http://localhost:8088/v3/api-docs -o src/api/generated.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4174"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@vitejs/plugin-vue": "6.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.11.0",
    "openapi-typescript": "7.13.0",
    "sass": "1.94.2",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-tsc": "3.1.4"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@vue/server-renderer": "3.5.24",
    "axios": "1.18.1",
    "dayjs": "1.11.19",
    "echarts": "6.1.0",
    "element-plus": "2.11.8",
    "pinia": "3.0.4",
    "vue": "3.5.24",
    "vue-router": "4.6.3"
  }
}
