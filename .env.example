MYSQL_DATABASE=pms3_replica
MYSQL_USER=pms3
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
REDIS_PASSWORD=change-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
PMS_CALLBACK_SIGNING_SECRET=replace-with-a-different-32-character-random-secret
# 留空时通过首次打开的网页创建项目与管理员；仅自动化/高级部署需要填写。
PMS_BOOTSTRAP_ADMIN_USERNAME=
PMS_BOOTSTRAP_ADMIN_PASSWORD=
# 正式交付默认开启：全新数据库不写入任何演示业务数据。
PMS_FORMAL_EMPTY_BASELINE=true
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
PMS_CALLBACK_MAX_SKEW_SECONDS=300
PMS_API_PORT=8088
PMS_WEB_PORT=5174
